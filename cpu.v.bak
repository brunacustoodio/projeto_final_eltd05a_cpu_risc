// Grupo: 20
// Nomes:
//   - Eric Giacomazzi Serafim - 2018018813
//   - Igor José Marinho Vieira - 2019015342
//   - Samuel Antônio Fernandes - 2020000656

// a) Latência do sistema:
//    - A CPU é pipeline com 5 estágios, com throughput de 1 instrução por ciclo.
//    - A latência por instrução individual (sem dependência) é 5 ciclos.
//    - A latência total do programa depende do número de instruções e dos NOPs (bubbles) inseridos para resolver data hazards.
//    - Exemplo: a instrução MUL (com 2N + 2 ciclos) é mascarada por pipeline, mas impacta a frequência, não a latência direta.
//    - Latência do sistema: 5 ciclos por instrução, exceto para instruções com stalls.

// b) Throughput do sistema:
//    - Com pipeline, o sistema executa 1 instrução por ciclo após o preenchimento do pipeline.
//    - Logo, throughput = 1 instrução/ciclo.

// c) Qual a máxima frequência operacional entregue pelo Time Quest Timing Analyzer para o multiplicador e para o sistema? (Indique a FPGA utilizada)
//    → FPGA utilizada: Cyclone IV GX - modelo EP4CGX150DF31I7AD
//    → Modelo adotado pelo Timing Analyzer: Slow 1200 mV @ 100°C
//    → Frequência máxima do multiplicador (isolado): 296,82 MHz
//    → Frequência máxima do multiplicador (inserido no sistema): 279,96 MHz
//    → Frequência máxima do sistema (sem multiplicador): [não especificado, presumivelmente maior que 279,96 MHz]

// d) Qual a máxima frequência de operação do sistema? (Indique a FPGA utilizada)
//    → Para multiplicador com latência 2N + 2 = 34 ciclos (N = 16):
//    → Frequência do sistema = 279,96 MHz / 34 ≈ **8,23 MHz**
//    → Logo, a frequência operacional do sistema total (com multiplicador acoplado) é **8,23 MHz**


// e) Metaestabilidade entre domínios de clock?
//    - Sim, **existe risco de metaestabilidade**, pois `CLK_SYS` e `CLK_MUL` são assíncronos.
//    - No entanto, se o protocolo de handshake for implementado corretamente (com registradores de sincronismo, sinal de `done`, etc.), o risco é mitigado.
//    - Portanto: **Não haverá problemas se a sincronização for feita corretamente** entre domínios.

// f) A multiplicação implementada é eficiente?
//    - **Não muito eficiente** em termos de velocidade para esta arquitetura MIPS.
//    - A latência do multiplicador impacta a frequência global do sistema (reduz para 1/34 da frequência do multiplicador).
//    - Mais adequado seria um multiplicador single-cycle com pipeline interno, mas isso aumentaria o uso de recursos.

// g) Sugestões para tornar o sistema mais rápido:
//    1. Substituir multiplicador sequencial por um **multiplicador combinacional ou pipelined**:
//       - Nova latência: 1 ciclo (combinacional) ou alguns ciclos (pipelined).
//       - Novo throughput: permanece 1 instrução/ciclo.
//       - Nova frequência: pode se aproximar dos 80 MHz (limitado pelo caminho crítico do sistema, não do multiplicador).

//    2. Uso de forwarding (bypass) para reduzir bubbles no pipeline:
//       - Reduz NOPs entre instruções dependentes.
//       - Aumenta o desempenho efetivo, reduzindo o CPI (clocks per instruction).

//    3. Inserção de hazard detection unit e stall automático (combinado com forwarding).
//       - Elimina a necessidade de inserção manual de NOPs.
//       - Torna o compilador/assembler mais eficiente.



module cpu(
    input CLK, Reset,
    input [31:0] Data_BUS_READ, Prog_BUS_READ,
    output [31:0] ADDR, Data_BUS_WRITE, ADDR_Prog,
    output CS, WE, CS_P
);

    //==================//
    //   Declarações    //
    //==================//
    (*keep=1*)wire [31:0] dataOut_Inst_M;
    (*keep=1*)wire [31:0] addressCorrection_mem1, addressCorrection_mem2, dataOut_Imm;
    (*keep=1*)wire [31:0] dataOut_RF1, dataOut_RF2;
    (*keep=1*)wire [31:0] writeBack, register_A, register_B;
    (*keep=1*)wire [31:0] dataOut_M1, dataOut_M2, dataOut_M3;
    (*keep=1*)wire [31:0] dataOut_ALU, dataOut_Mult, dataOut_D1, dataOut_D2;
    (*keep=1*)wire [24:0] ctrl0, ctrl1, ctrl2;
    (*keep=1*)wire [25:0] ctrl3;
    (*keep=1*)wire [31:0] dataOut_PC;
    (*keep=1*)wire CLK_MUL, CLK_SYS;
    (*keep=1*)wire dataOut_M;
    (*keep=1*)wire [31:0] fioA, fioB;
    (*keep=1*)wire reset_control;
    (*keep=1*)wire zeroFlag;
    (*keep=1*)wire pc_jmpFlag;
    (*keep=1*)wire pc_branchFlag;
    (*keep=1*)wire CS_WB;

    (*keep=1*)wire [31:0] dataOut_Extend;
    (*keep=1*)wire [31:0] dataOut_InstMem;
    (*keep=1*)wire iWE;
    (*keep=1*)wire [9:0] iAddress;
    (*keep=1*)wire [31:0] dout;
    (*keep=1*)wire [31:0] tempOut;

    assign CS_WB = ctrl3[25];
    assign ADDR = dataOut_D1;
    assign WE = ctrl1[3];
    assign ADDR_Prog = dataOut_PC - 32'h1680;
    assign iAddress = dataOut_D1 - 32'h16E4;
    assign Data_BUS_WRITE = fioB;

    //==================//
    //     Clock        //
    //==================//
    PLL pll (
        .inclk0 (CLK),
        .c0 (CLK_MUL),
        .c1 (CLK_SYS)
    );  

    //===========================//
    //  Memória de Instruções    //
    //===========================//
    InstMem Intruction_Memory(
        .clock(CLK_SYS),
        .address(ADDR_Prog),
        .q(dataOut_Inst_M)
    );

    //===========================//
    //        Program Counter    //
    //===========================//
    pc PC(
        .Clk(CLK_SYS),
        .Reset(Reset),
        .zeroFlag(zeroFlag),
        .jmpFlag(ctrl0[0]),
        .branchFlag(ctrl1[1]),
        .jmpAddress(dataOut_Extend),
        .branchOffset(dataOut_Imm),
        .addr(dataOut_PC),
        .resetControl(reset_control)
    );

    //=====================================//
    //    Mux para leitura de instrução    //
    //=====================================//
    mux MUX_INSTR_SRC( // Seleciona instrução da memória interna ou do barramento externo
        .sel(CS_P),
        .a(Prog_BUS_READ),
        .b(dataOut_Inst_M),
        .out(tempOut)
    );

    ADDRDecoding_Prog addrDecoding_Prog(
        .addr(dataOut_PC),
        .CS_P(CS_P)
    );

    //================================//
    //     Banco de Registradores     //
    //================================//
    registerfile Register_File(
        .Clk(CLK_SYS),
        .we(ctrl3[9]),
        .rs(ctrl0[24:20]),
        .rt(ctrl0[19:15]),
        .rd(ctrl3[14:10]),
        .in(writeBack),
        .outA(fioA),
        .outB(fioB),
        .resetControl(reset_control)
    );

    //===========================//
    //     Unidade de Controle   //
    //===========================//
    control Control(
        .in(tempOut),
        .out(ctrl0)
    );

    //===========================//
    //    Extensor de Imediato   //
    //===========================//
    extend Extend(
        .in(tempOut),
        .out(dataOut_Extend)
    );

    register IMM(
        .Clk(CLK_SYS),
        .Reset(reset_control),
        .in(dataOut_Extend),
        .out(dataOut_Imm)
    );

    //===========================//
    //     Pipeline: Controle 1  //
    //===========================//
    register CTRL1 (
        .Clk(CLK_SYS),
        .Reset(reset_control),
        .in(ctrl0[24:0]),
        .out(ctrl1[24:0])
    );

    //================================//
    //     Unidade de Multiplicação   //
    //================================//
    Multiplicador MULTIPLICADOR(
        .Clk(CLK_MUL),
        .St(ctrl1[5]),
        .Multiplicador(fioA[15:0]),
        .Multiplicando(fioB[15:0]),
        .Produto(dataOut_Mult)
    );

    //================================//
    //     Mux para entrada da ALU 	  //
    //================================//
    mux MUX_ALU_SRC( // Seleciona segundo operando da ALU (fioB ou imediato)
        .sel(ctrl1[8]),
        .a(fioB),
        .b(dataOut_Imm),
        .out(dataOut_InstMem)
    );

    //=====================================//
    //     Unidade Lógica e Aritmética     //
    //=====================================//
    alu ALU(
        .sel(ctrl1[7:6]),
        .a(fioA),
        .b(dataOut_InstMem),
        .out(dataOut_ALU),
        .zeroFlag(zeroFlag)
    );

    //=====================================//
    //     Mux para resultado ALU/MULT     //
    //=====================================//
    mux MUX_ALU_MULT( // Seleciona resultado da ALU ou do multiplicador
        .sel(ctrl1[4]),
        .a(dataOut_Mult),
        .b(dataOut_ALU),
        .out(dataOut_D1)
    );

    //================================//
    //     Decodificação de Endereço  //
    //================================//
    ADDRDecoding ADDR_Decoding (
        .WE(ctrl1[3]),
        .iWE(iWE),
        .iAddress(addressCorrection_mem2),
        .addr(dataOut_D1),
        .cs(CS)
    );

    //===========================//
    //     Memória de Dados      //
    //===========================//
    datamemory Data_Memory (
        .clock(CLK_SYS), 
        .wren(iWE), 
        .address(iAddress),
        .data(fioB),
        .q(dout)
    );

    //===============================================//
    //   Mux para writeBack (RAM externa ou local)   //
    //===============================================//
    mux MUX_MEM_SRC( // Seleciona entre RAM externa e RAM local para WriteBack
        .sel(CS_WB),
        .a(Data_BUS_READ), 
        .b(dout),
        .out(dataOut_M3)
    );

    mux MUX_WB_FINAL( // Seleciona valor final a ser escrito no registrador (RAM ou D2)
        .sel(ctrl3[2]),
        .a(dataOut_M3), 
        .b(dataOut_D2),
        .out(writeBack)
    );

    //================================//
    //     Pipeline: registrador D    //
    //================================//
    register D(
        .Clk(CLK_SYS),
        .Reset(Reset),
        .in(dataOut_D1),
        .out(dataOut_D2)
    );

    //=====================================//
    //     Pipeline: registrador CTRL3     //
    //=====================================//
    register #(26) CTRL3 (
        .Clk(CLK_SYS),
        .Reset(Reset),
        .in({CS, ctrl1[24:0]}),
        .out(ctrl3)
    );

endmodule
